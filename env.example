# ============================================
# Monitor de Ruido en Aulas - Configuracion
# ============================================
# Renombra este fichero a .env y ajusta los valores:
#   mv env.example .env
#
# El .env NO se commitea (esta en .gitignore).

# ---- Broker MQTT (donde publican los micros) ----
# Los micros flasheados apuntan a broker.hivemq.com.
# Si cambias de broker, hay que reflashear el firmware.
MQTT_BROKER=mqtt://broker.hivemq.com
MQTT_PORT=1883

# ---- Basic Auth para el dashboard publico ----
# Usuario: el que quieras
BASIC_AUTH_USER=admin

# Hash bcrypt de la contrasena. Generalo con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TU_CONTRASENA'
# IMPORTANTE: en docker-compose escapa los $ duplicandolos: $$ en vez de $
BASIC_AUTH_HASH=$$2a$$14$$REEMPLAZA_ESTO_CON_TU_HASH_BCRYPT

# ---- Retencion de datos (rollup en escalera) ----
# raw (cada 5s) -> se agrega a 1min y se borra tras N dias
RAW_RETENTION_DAYS=14
# minute (cada 1 min) -> se agrega a 1h y se borra tras N dias
MINUTE_RETENTION_DAYS=180
# hour (cada 1 h) -> se guarda para siempre (para comparar años)
